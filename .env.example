# Browser-safe Supabase project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by app/api/account/delete to call the Supabase Auth
# admin API. Use the service_role key or a Supabase secret key (sb_secret_...).
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternative name for newer Supabase secret keys; either one works.
# SUPABASE_SECRET_KEY=
